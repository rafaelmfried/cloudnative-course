# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editores
# .vscode/settings.json é versionado de propósito — carrega a proteção
# do CODEOWNERS (formatter off) pro fork de cada aluno.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Variáveis de ambiente (.env é local, .env.example é commitado)
.env
.env.local
.env.*.local

