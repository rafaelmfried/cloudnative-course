# EditorConfig — consistência de formatação entre editores.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go usa tabs — é o padrão da linguagem (gofmt).
[*.go]
indent_style = tab
indent_size = 4

# go.mod / go.sum
[go.{mod,sum}]
indent_style = tab

# Makefile exige tab — espaço quebra o Make.
[{Makefile,*.mk}]
indent_style = tab

# Markdown — não cortar trailing space (dois espaços = quebra de linha).
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# CODEOWNERS não é Markdown — sem formatação.
[CODEOWNERS]
trim_trailing_whitespace = true
indent_style = space
